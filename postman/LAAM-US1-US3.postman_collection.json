            ]
          }
        }
      ]
    },
    {
      "name": "US2 - non-rider rejected (configure staff token)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/riders/me/pickups"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "pm.test(\"Private response is not cached\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "US3 - pickup sender contact",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{pickupToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{pickupTaskId}}/contact"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "pm.test(\"Private response is not cached\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Sender phone\", () => pm.expect(pm.response.json()).to.eql({ taskId: pm.collectionVariables.get(\"pickupTaskId\"), phone: \"0811111111\" }));"
            ]
          }
        }
      ]
    },
