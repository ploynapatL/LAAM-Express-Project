              "pm.test(\"Private response is not cached\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Receiver phone\", () => pm.expect(pm.response.json().phone).to.eql(\"0822222222\"));"
            ]
          }
        }
      ]
    },
