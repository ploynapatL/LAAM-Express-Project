
# ==================================================
# LAAM Express - Environment Configuration Template
# ==================================================
# Copy this file to server/.env for local development.
# For Render, configure variables in the Dashboard.
# Never commit .env or real credentials to GitHub.


# --------------------------------------------------
# 1. Server Configuration
# --------------------------------------------------

# Local port. Render provides PORT automatically.
PORT=3001
# Optional bind address. Local default is 127.0.0.1.
# HOST=127.0.0.1


# --------------------------------------------------
# 2. Local PostgreSQL Configuration
# --------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=laam_express_dev
DB_USER=laam_api
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD


# --------------------------------------------------
# 3. Cloud PostgreSQL Configuration (Render)
# --------------------------------------------------

# Leave empty for local development.
# If set, DATABASE_URL takes priority over DB_* variables.
# Use the External Database URL for cross-workspace deployment.
# TLS is enabled automatically by db.js when DATABASE_URL is set.

DATABASE_URL=


# --------------------------------------------------
# 4. CORS Configuration
# --------------------------------------------------

# Optional origins for existing external API clients. The website uses the
# same origin as Express, so it does not need this setting.
FRONTEND_ORIGINS=


# --------------------------------------------------
# 5. Reverse Proxy Configuration
# --------------------------------------------------

# 0 = Do not trust proxies (local default).
# For Render, configure only after verifying proxy topology.

TRUST_PROXY_HOPS=0


# --------------------------------------------------
# 6. Rider Authentication
# --------------------------------------------------

# Optional legacy API credentials for Postman and existing Bearer clients.
# Website riders sign in with a provisioned account.
RIDER_TOKENS_JSON=
