# Copy to server/.env after PostgreSQL has been installed. Never commit .env.
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=laam_express_dev
DB_USER=laam_api
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500
# Replace keys with distinct random secrets (32+ characters, no whitespace).
# IDs 1 and 2 match database/seed.sql on a fresh database only.
RIDER_TOKENS_JSON={"REPLACE_WITH_RANDOM_PICKUP_TOKEN_32_CHARS":1,"REPLACE_WITH_RANDOM_DELIVERY_TOKEN_32_CHARS":2}
